PS D:\Projects\cynaris-internship-Salma> python -c "import pandas as pd; orders=pd.read_csv('data/orders.csv'); customers=pd.read_csv('data/customers.csv'); products=pd.read_csv('data/products.csv'); merged=orders.merge(customers,on='Customer_ID',how='left').merge(products,on='Product_ID',how='left'); merged['Revenue']=merged['Quantity']*merged['Price (INR)']; pivot=merged.pivot_table(index='City',columns='Category',values='Revenue',aggfunc='sum',fill_value=0); print('========== PIVOT TABLE =========='); print('Revenue by City and Category:'); print(pivot.head(10).to_string()); print('\nPivot table shape:',pivot.shape)"
